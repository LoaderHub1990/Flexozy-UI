    local function TargetScale()
        local cam = workspace.CurrentCamera
        local fit = 1
        if cam then
            local vp = cam.ViewportSize
            fit = math.min(vp.X * 0.94 / size.X, vp.Y * 0.92 / size.Y)
        end
        -- จอเล็กจะย่ออัตโนมัติ และไม่ให้ขยายเกินขนาดจอ
        return math.max(0.2, math.min(W.UserScale * math.min(1, fit), fit))
    end
    local function Rescale() Scale.Scale = TargetScale() end
    Rescale()
    if workspace.CurrentCamera then
        Conn(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), Rescale)
